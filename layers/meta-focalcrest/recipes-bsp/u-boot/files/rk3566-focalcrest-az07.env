bootdelay=1
baudrate=1500000

fdtfile=rockchip/rk3566-focalcrest-az07.dtb

loadaddr=0x0a000000

bootdev=0
bootpart=boot
bootfit=kernel.fit

bootargs=root=PARTLABEL=rootfs rootwait rw rootfstype=ext4 earlycon console=ttyS2,1500000n8

fc_bootcmd=part number mmc ${bootdev} ${bootpart} fcpart && load mmc ${bootdev}:${fcpart} ${loadaddr} ${bootfit} && bootm ${loadaddr}; reset
bootcmd=run fc_bootcmd
